<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.kalayciburak</groupId>
    <artifactId>stackmate-parent</artifactId>
    <version>0.1.0-rc.3</version>
  </parent>
  <artifactId>stackmate-e2e</artifactId>
  <name>StackMate Packaged End-to-End Tests</name>
  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.github.kalayciburak</groupId>
      <artifactId>stackmate-sample</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/PackagedFakeChildIT.java</exclude>
            <exclude>**/PackagedRealModelIT.java</exclude>
          </excludes>
          <systemPropertyVariables>
            <stackmate.e2e.sample-jar>${maven.multiModuleProjectDirectory}/stackmate-sample/target/stackmate-sample-${project.version}.jar</stackmate.e2e.sample-jar>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>real-model-e2e</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration combine.self="override">
              <includes>
                <include>**/PackagedRealModelIT.java</include>
              </includes>
              <systemPropertyVariables>
                <stackmate.e2e.sample-jar>${maven.multiModuleProjectDirectory}/stackmate-sample/target/stackmate-sample-${project.version}.jar</stackmate.e2e.sample-jar>
                <stackmate.e2e.model-path>${stackmate.model.path}</stackmate.e2e.model-path>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
