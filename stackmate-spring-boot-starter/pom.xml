<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.kalayciburak</groupId>
    <artifactId>stackmate-parent</artifactId>
    <version>0.1.0-rc.3</version>
  </parent>
  <artifactId>stackmate-spring-boot-starter</artifactId>
  <name>StackMate Spring Boot Starter</name>
  <properties>
    <cyclonedx.skip>false</cyclonedx.skip>
    <maven.javadoc.skip>false</maven.javadoc.skip>
    <maven.source.skip>false</maven.source.skip>
    <stackmate.release.resources.skip>false</stackmate.release.resources.skip>
    <stackmate.public.enforcer.skip>false</stackmate.public.enforcer.skip>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.github.kalayciburak</groupId>
      <artifactId>stackmate-spring-boot-autoconfigure</artifactId>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>public-release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-placeholder-sources</id>
                <goals>
                  <goal>jar</goal>
                </goals>
                <phase>package</phase>
                <configuration>
                  <classifier>sources</classifier>
                  <classesDirectory>${project.basedir}/src/release/sources</classesDirectory>
                </configuration>
              </execution>
              <execution>
                <id>attach-placeholder-javadoc</id>
                <goals>
                  <goal>jar</goal>
                </goals>
                <phase>package</phase>
                <configuration>
                  <classifier>javadoc</classifier>
                  <classesDirectory>${project.basedir}/src/release/javadoc</classesDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
